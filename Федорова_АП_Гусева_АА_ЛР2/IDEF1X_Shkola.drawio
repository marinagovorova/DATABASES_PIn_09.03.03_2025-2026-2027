h="60" height="36" as="geometry"/></mxCell><mxCell id="lgt1" value="Зависимая сущность (ключ содержит FK)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="135" y="1678" width="420" height="36" as="geometry"/></mxCell><mxCell id="lge0" value="" style="html=1;endArrow=oval;endFill=1;endSize=7;strokeColor=#555555;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1646" as="sourcePoint"/><mxPoint x="730" y="1646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lget0" value="Идентифицирующая связь (FK входит в ключ потомка)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="1628" width="480" height="36" as="geometry"/></mxCell><mxCell id="lge1" value="" style="html=1;endArrow=oval;endFill=1;endSize=7;strokeColor=#555555;dashed=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1696" as="sourcePoint"/><mxPoint x="730" y="1696" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lget1" value="Неидентифицирующая обязательная связь" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="1678" width="480" height="36" as="geometry"/></mxCell><mxCell id="lge2" value="" style="html=1;endArrow=oval;endFill=1;endSize=7;strokeColor=#555555;dashed=1;startArrow=diamondThin;startFill=0;startSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1746" as="sourcePoint"/><mxPoint x="730" y="1746" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lget2" value="Неидентифицирующая необязательная связь (FK может быть NULL)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="1728" width="480" height="36" as="geometry"/></mxCell><mxCell id="lgn" value="Точка — сторона «много» (родитель → потомок). Над чертой — первичный ключ, под чертой — неключевые атрибуты. (FK) — внешний ключ, (AK1) — альтернативный (уникальный) ключ; если AK1 стоит у нескольких атрибутов, уникальна их комбинация." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="1788" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>